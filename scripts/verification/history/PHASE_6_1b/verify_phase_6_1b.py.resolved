# scripts/verification/verify_phase_6_1b.py
import os
import sys
import ast
import json
import sqlite3

# Ajusta path para importar o core
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../..')))

from core.app_state import AppState
from core.config_manager import ConfigManager

def verify():
    print("=" * 70)
    print("  VERIFICAÇÃO DE INTEGRAÇÃO - FASE 6.1b")
    print("=" * 70)

    results = {}
    db_path = "test_verify_61b.db"
    if os.path.exists(db_path): os.remove(db_path)

    try:
        # 1. Verificar ConfigManager (Default auto_open_viewer)
        print("\n1. Verificando ConfigManager...")
        config = ConfigManager()
        # Forçamos o reload ou checamos o default via _get_default_config indiretamente
        # Na verdade, basta checar se o campo existe no retorno do config atual
        val = config.get("ui", "auto_open_viewer", "NOT_FOUND")
        if val != "NOT_FOUND":
            print(f"  ✅ Campo 'auto_open_viewer' expandido no default: {val}")
            results["config_default"] = True
        else:
            print("  ❌ Campo 'auto_open_viewer' não encontrado no ConfigManager")
            results["config_default"] = False

        # 2. Verificar AppState (Delegation)
        print("\n2. Verificando AppState Delegation...")
        app_state = AppState()
        has_discovery = hasattr(app_state, "discover_ai_models")
        has_health = hasattr(app_state, "is_ai_provider_available")
        has_context = hasattr(app_state, "get_ai_model_context")
        
        if has_discovery and has_health and has_context:
            print("  ✅ AppState possui todos os métodos de delegação de IA")
            results["app_state_delegation"] = True
        else:
            print(f"  ❌ Métodos faltando no AppState: discovery={has_discovery}, health={has_health}, context={has_context}")
            results["app_state_delegation"] = False

        # 3. Verificar UI Import Barrier (Análise Estática via AST)
        print("\n3. Verificando Import Barrier (UI -> Services)...")
        ui_files = [
            "ui/tab_analysis.py",
            "ui/virtual_table.py",
            "ui/app_window.py",
            "ui/dialog_config.py",
            "ui/tab_batch.py"
        ]
        
        violations = []
        for filepath in ui_files:
            if not os.path.exists(filepath):
                continue
            try:
                with open(filepath, 'r', encoding='utf-8') as f:
                    source = f.read()
                tree = ast.parse(source)
                for node in ast.walk(tree):
                    if isinstance(node, (ast.Import, ast.ImportFrom)):
                        if isinstance(node, ast.ImportFrom) and node.module:
                            if node.module.startswith("services.ai_"):
                                violations.append(
                                    f"{filepath}: from {node.module} import ..."
                                )
                        elif isinstance(node, ast.Import):
                            for alias in node.names:
                                if alias.name.startswith("services.ai_"):
                                    violations.append(
                                        f"{filepath}: import {alias.name}"
                                    )
            except Exception as e:
                print(f"  ⚠️ Erro ao analisar {filepath}: {e}")

        if violations:
            print(f"  ❌ Violações encontradas:")
            for v in violations:
                print(f"    - {v}")
            results["import_barrier"] = False
        else:
            print("  ✅ Nenhuma violação — UI isolada de services/")
            results["import_barrier"] = True

    finally:
        if os.path.exists(db_path):
            os.remove(db_path)

    # ─── RELATÓRIO FINAL ─────────────────────────────────────
    print("\n" + "=" * 70)
    print("  RELATÓRIO FINAL")
    print("=" * 70)

    all_pass = True
    for test_name, passed in results.items():
        status = "✅ PASS" if passed else "❌ FAIL"
        print(f"  {status}  {test_name}")
        if not passed:
            all_pass = False

    print("=" * 70)
    if all_pass:
        print("  🎉 TODOS OS TESTES PASSARAM — Fase 6.1b VALIDADA!")
    else:
        print("  ⚠️ ALGUNS TESTES FALHARAM — Revise antes de prosseguir")
    print("=" * 70)

if __name__ == "__main__":
    verify()

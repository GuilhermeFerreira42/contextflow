{
  "name": "contextflow-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ContextFlow V1 — biblioteca local de vídeos do YouTube com transcrições e resumos (monólito modular Node.js + TypeScript)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "src/motor",
    "src/interface",
    "src/compartilhado"
  ],
  "scripts": {
    "dev": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning --test \"testes/**/*.test.ts\"",
    "test:e2e": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning testes/e2e/executar.mjs",
    "test:e2e:refinamentos": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning testes/e2e/refinamentos-ui.mjs",
    "test:e2e:resumos": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning testes/e2e/resumos-f6.mjs",
    "verificar": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verificar.mjs",
    "test:e2e:pos-f6": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning testes/e2e/pos-f6.mjs",
    "test:e2e:miniatura": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning testes/e2e/miniatura-adaptativa.mjs",
    "test:e2e:capas": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning testes/e2e/recuperacao-miniaturas.mjs",
    "test:e2e:visualizacao": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning testes/e2e/painel-visualizacao.mjs",
    "test:e2e:estabilizacao": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning testes/e2e/estabilizacao-f6b.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.56.1",
    "typescript": "^5.7.0"
  }
}

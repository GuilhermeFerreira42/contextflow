## PARTE 11 — GUIA DE REPLICAÇÃO

### Pré-requisitos
- Python 3.10+ (testado com 3.11)
- wxPython 4.2.1+
- Ollama instalado (`ollama serve` rodando em `localhost:11434`)
- Acesso ao repositório ContextFlow

### Passo a Passo

**1. Verificar estado atual (antes da correção):**
```bash
# Confirmar que o bug existe:
python main.py
# Selecionar Aba 2 → Toolbar → Selecionar "ollama"
# RESULTADO ESPERADO: UI trava por vários segundos
```

**2. Aplicar correções na sequência obrigatória:**

```bash
# FASE 1: constants.py
# Adicionar ao final do arquivo:
echo '
# --- AI Discovery Cache Configuration ---
AI_DISCOVERY_CACHE_TTL_SECONDS = 60
AI_PROVIDER_AVAILABILITY_CACHE_TTL_SECONDS = 30
' >> constants.py
```

**3. Modificar `services/ai_discovery.py`:**

Localizar e substituir o método `discover_models` e `__init__`:

```python
# Em AIDiscovery.__init__(), ADICIONAR após self._lock = threading.Lock():
self._cache_timestamps: Dict[str, float] = {}

# MODIFICAR discover_models para:
def discover_models(self, provider: str = None, force_refresh: bool = False) -> List[Dict[str, Any]]:
    """
    Descobre modelos para o provedor especificado.
    [BISTURI-OLLAMA] Cache com TTL de AI_DISCOVERY_CACHE_TTL_SECONDS.
    Chamada HTTP SOMENTE se cache expirado ou force_refresh=True.
    
    NUNCA chamar na Main Thread — usar via AppState.discover_ai_models()
    """
    from constants import AI_DISCOVERY_CACHE_TTL_SECONDS
    import time
    
    if provider is None:
        provider = self.config.get("orchestration", "active_provider", "ollama")
    
    with self._lock:
        # [CACHE-FIRST] Verifica TTL antes de qualquer HTTP
        if not force_refresh and provider in self._cache:
            age = time.time() - self._cache_timestamps.get(provider, 0)
            if age < AI_DISCOVERY_CACHE_TTL_SECONDS:
                logger.debug(
                    f"AIDiscovery: cache hit para '{provider}' "
                    f"(TTL restante: {AI_DISCOVERY_CACHE_TTL_SECONDS - age:.0f}s)"
                )
                return self._cache[provider]
        
        logger.info(f"AIDiscovery: fetch HTTP iniciado para '{provider}' (cache expirado ou force_refresh)")
        
        start = time.time()
        if provider == "ollama":
            models = self._discover_ollama()
        elif provider == "google":
            models = self._discover_google()
        else:
            logger.warning(f"Provider '{provider}' não suportado para discovery.")
            models = []
        
        elapsed = time.time() - start
        logger.info(f"AIDiscovery: {len(models)} modelos descobertos para '{provider}' em {elapsed:.2f}s")
        
        self._cache[provider] = models
        self._cache_timestamps[provider] = time.time()
        return models

def invalidate_cache(self, provider: str = None):
    """
    [BISTURI-OLLAMA] Limpa cache para forçar re-discovery.
    Se provider=None, limpa tudo.
    """
    with self._lock:
        if provider:
            self._cache.pop(provider, None)
            self._cache_timestamps.pop(provider, None)
            logger.info(f"AIDiscovery: Cache invalidado para '{provider}'.")
        else:
            self._cache.clear()
            self._cache_timestamps.clear()
            logger.info("AIDiscovery: Cache completo invalidado.")
```

**4. Modificar `core/app_state.py`:**

```python
# SUBSTITUIR o método discover_ai_models():
def discover_ai_models(self, provider: str = None, callback=None, force_refresh: bool = False):
    """
    [BISTURI-OLLAMA] Descobre modelos de IA disponíveis em background.
    CORREÇÃO: Usa provider correto para executor (ollama → _ai_executor).
    O callback recebe a lista de modelos e DEVE usar wx.CallAfter internamente.
    
    Args:
        provider: Nome do provedor (None = active_provider)
        callback: Callable[[List[Dict]], None] chamado com resultado
        force_refresh: Se True, ignora TTL e força re-fetch
    """
    if provider is None:
        provider = self.config.get("orchestration", "active_provider", "ollama")
    
    logger.info(f"AppState: discovery enfileirada para provider='{provider}'")
    
    def _discover():
        from services.ai_discovery import AIDiscovery
        discovery = AIDiscovery()
        models = discovery.discover_models(provider=provider, force_refresh=force_refresh)
        if callback:
            callback(models)
    
    # [CORREÇÃO CRÍTICA] Usa "ollama" como provider para enfileirar no
    # _ai_executor (max_workers=1), não no _generic_executor.
    # Antes: provider="generic" → competia com downloads
    # Depois: provider="ollama" → pool dedicado para AI local
    executor_provider = provider if provider in ("ollama",) else "generic"
    
    self.task_manager.submit_task(
        "ai_discovery",
        _discover,
        provider=executor_provider
    )

# ADICIONAR após discover_ai_models():
def is_ai_provider_available(self, provider: str = None) -> bool:
    """
    [BISTURI-OLLAMA] Verifica se o provedor de IA está acessível.
    CORREÇÃO: Retorna resultado cacheado para evitar HTTP na Main Thread.
    Cache com TTL de AI_PROVIDER_AVAILABILITY_CACHE_TTL_SECONDS.
    A verificação real ocorre em background thread.
    """
    import time
    from constants import AI_PROVIDER_AVAILABILITY_CACHE_TTL_SECONDS
    
    if provider is None:
        provider = self.config.get("orchestration", "active_provider", "ollama")
    
    # Inicializa cache se necessário
    if not hasattr(self, '_availability_cache'):
        self._availability_cache = {}
        self._availability_timestamps = {}
    
    # [CACHE-FIRST] Retorna resultado cacheado se TTL válido
    if provider in self._availability_cache:
        age = time.time() - self._availability_timestamps.get(provider, 0)
        if age < AI_PROVIDER_AVAILABILITY_CACHE_TTL_SECONDS:
            return self._availability_cache[provider]
    
    # [BACKGROUND] Dispara verificação assíncrona e retorna último resultado conhecido
    def _check_availability():
        import time as t
        result = False
        if provider == "ollama":
            import requests
            endpoint = self.config.get("ollama", "endpoint", "http://localhost:11434")
            try:
                r = requests.get(f"{endpoint}/", timeout=3)
                result = r.status_code == 200
            except Exception:
                result = False
        
        # Atualiza cache na worker thread (thread-safe para dict simples)
        self._availability_cache[provider] = result
        self._availability_timestamps[provider] = t.time()
        logger.debug(f"AppState: provider '{provider}' disponível: {result}")
    
    # Submete verificação em background (não bloqueia caller)
    self.task_manager.submit_task(
        f"availability_check_{provider}",
        _check_availability,
        provider="generic"
    )
    
    # Retorna último valor conhecido (False se primeira verificação)
    return self._availability_cache.get(provider, False)
```

**5. Modificar `ui/components/analysis_toolbar.py`:**

```python
# MODIFICAR populate_model_selector():
def populate_model_selector(self, force_refresh: bool = False):
    """
    [BISTURI-OLLAMA] Inicia descoberta assíncrona de modelos.
    NÃO bloqueia a Main Thread.
    Resultado entregue via on_models_discovered() com wx.CallAfter.
    """
    provider = self.choice_provider.GetStringSelection()
    self.lbl_ai_status.SetLabel("🔍 Buscando modelos...")
    self.choice_model.Enable(False)
    
    # [BISTURI-OLLAMA] Callback nomeado garante rastreabilidade e wx.CallAfter
    def on_models_discovered(models):
        """
        Callback chamado da worker thread quando discovery concluída.
        [THREAD SAFETY] wx.CallAfter OBRIGATÓRIO — este método é chamado
        do _ai_executor pool, não da Main Thread.
        """
        # Guarda contra widget destruído (dialog fechado durante discovery)
        try:
            wx.CallAfter(self._update_model_selector, models or [])
        except Exception as e:
            logger.debug(f"AnalysisToolbar: widget destruído durante discovery: {e}")
    
    self.app_state.discover_ai_models(
        provider=provider,
        callback=on_models_discovered,
        force_refresh=force_refresh
    )

# MODIFICAR _bind_events() — botão refresh com force_refresh=True:
def _bind_events(self):
    self.choice_provider.Bind(wx.EVT_CHOICE, self._on_provider_changed)
    self.choice_model.Bind(wx.EVT_CHOICE, self._on_model_changed)
    # [BISTURI-OLLAMA] force_refresh=True invalida cache e força HTTP
    self.btn_refresh_models.Bind(
        wx.EVT_BUTTON, 
        lambda e: self.populate_model_selector(force_refresh=True)
    )
```


**FASE 4 — `scripts/verification/verify_phase_7_1.py`**
```python
# scripts/verification/verify_phase_7_1.py
import os
import sys
sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..')))

def verify_cta_text():
    """Verifica que SummaryStatusRenderer usa '✦ Resumir' para status vazio."""
    from ui.virtual_table import SummaryStatusRenderer
    renderer = SummaryStatusRenderer()
    # Verifica que o método Draw não usa "—" para status vazio
    import inspect
    source = inspect.getsource(renderer.Draw)
    assert "✦ Resumir" in source, "CTA '✦ Resumir' não encontrado no renderer"
    assert '"—"' not in source, "Texto estático '—' ainda presente no renderer"
    print("✅ CTA '✦ Resumir' confirmado no SummaryStatusRenderer")

def verify_detail_panel_bg_init():
    """Verifica que _init_ui do DetailPanel usa bg_hex do tema."""
    import inspect
    from ui.panel_detail import DetailPanel
    source = inspect.getsource(DetailPanel._init_ui)
    assert "bg_hex" in source, "bg_hex não encontrado no _init_ui do DetailPanel"
    assert "fg_hex" in source, "fg_hex não encontrado no _init_ui do DetailPanel"
    assert "initial_html" in source or "bg_hex" in source, \
        "HTML inicial com tema não encontrado"
    print("✅ DetailPanel._init_ui usa bg_hex/fg_hex do tema")

def verify_interactive_cols():
    """Verifica que on_grid_motion inclui Preview e Resumo como interativas."""
    import inspect
    from ui.tab_analysis import TabAnalysis
    source = inspect.getsource(TabAnalysis.on_grid_motion)
    assert "Preview" in source, "Coluna 'Preview' não detectada em on_grid_motion"
    assert "Resumo" in source, "Coluna 'Resumo' não detectada em on_grid_motion"
    assert "CURSOR_HAND" in source, "CURSOR_HAND não encontrado em on_grid_motion"
    print("✅ on_grid_motion inclui Preview e Resumo nas colunas interativas")

def verify_thumbnail_dialog_method():
    """Verifica que _show_thumbnail_dialog existe na TabAnalysis."""
    from ui.tab_analysis import TabAnalysis
    assert hasattr(TabAnalysis, '_show_thumbnail_dialog'), \
        "Método _show_thumbnail_dialog não encontrado em TabAnalysis"
    import inspect
    source = inspect.getsource(TabAnalysis._show_thumbnail_dialog)
    assert "ShowModal" in source, "ShowModal não encontrado no dialog"
    assert "Destroy" in source, "Destroy não encontrado — possível memory leak"
    print("✅ _show_thumbnail_dialog existe e chama Destroy()")

def verify_range_select_handler():
    """Verifica que _on_range_select existe e usa flag de proteção."""
    from ui.tab_analysis import TabAnalysis
    assert hasattr(TabAnalysis, '_on_range_select'), \
        "Método _on_range_select não encontrado"
    import inspect
    source = inspect.getsource(TabAnalysis._on_range_select)
    assert "_is_programmatic_selection" in source, \
        "Flag _is_programmatic_selection não encontrada em _on_range_select"
    print("✅ _on_range_select usa flag de proteção contra loop")

def verify_icon_draw_order():
    """Verifica que LinkIconRenderer chama DrawRectangle antes de DrawText."""
    import inspect
    from ui.virtual_table import LinkIconRenderer
    source = inspect.getsource(LinkIconRenderer.Draw)
    rect_pos = source.find("DrawRectangle")
    text_pos = source.find("DrawText")
    assert rect_pos < text_pos, \
        f"DrawRectangle ({rect_pos}) deve vir ANTES de DrawText ({text_pos})"
    print("✅ LinkIconRenderer: DrawRectangle antes de DrawText")

if __name__ == "__main__":
    tests = [
        verify_cta_text,
        verify_detail_panel_bg_init,
        verify_interactive_cols,
        verify_thumbnail_dialog_method,
        verify_range_select_handler,
        verify_icon_draw_order,
    ]
    failed = 0
    for test in tests:
        try:
            test()
        except AssertionError as e:
            print(f"❌ FALHA: {e}")
            failed += 1
        except Exception as e:
            print(f"💥 ERRO: {e}")
            failed += 1

    if failed == 0:
        print(f"\n🎉 TODOS OS {len(tests)} TESTES PASSARAM — FASE 7.1 VERIFICADA")
    else:
        print(f"\n❌ {failed}/{len(tests)} TESTES FALHARAM")
        sys.exit(1)
```

## 9.4 Métricas de Sucesso

| Métrica | Target | Como Medir |
|---|---|---|
| Testes de verificação | 6/6 passando | `python verify_phase_7_1.py` |
| Arquivos modificados | ≤ 3 | `git diff --name-only` |
| Linhas adicionadas | ≤ 120 | `git diff --stat` |
| Crashes em testes manuais | 0 | Clicar em Preview sem thumb, grid motion, toggle tema |
| Flash de contraste no init | 0 ocorrências | Inicializar em dark mode, observar DetailPanel |

## 9.5 Riscos Técnicos

| Risco | Probabilidade | Impacto | Mitigação |
|---|---|---|---|
| Loop infinito em `_on_range_select` | Baixa | Alto | Flag `_is_programmatic_selection` com `try/finally` |
| Conflito entre `EVT_GRID_SELECT_CELL` existente e novo | Média | Médio | Novo handler usa `event.Skip()` para propagar ao existente |
| `wx.html2` WebView timing em diferentes OS | Baixa | Médio | HTML base já completo; não depende de JS timing |
| Dialog thumbnail com imagem grande travando UI | Baixa | Médio | Scale calculado antes de criar Bitmap; operação síncrona mas rápida |
| `CalcUnscrolledPosition` retornando coordenadas incorretas | Baixa | Baixo | Guard `col >= 0 and col < len(self.col_labels)` |
| Destroy de Dialog em `EVT_BUTTON` causando crash | Baixa | Alto | `dlg.Close()` em vez de `dlg.Destroy()` no lambda; `Destroy()` após `ShowModal()` |
| `_is_programmatic_selection` não inicializada | Baixa | Médio | `self._is_programmatic_selection = False` no `__init__` da `TabAnalysis` |
| Renderer com clipping region não destruído em exceção | Baixa | Baixo | `try/finally` com `dc.DestroyClippingRegion()` nos renderers críticos |


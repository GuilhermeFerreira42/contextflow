E os handlers:

```python
    def _on_ai_summary_started(self, video_id, **kwargs):
        wx.CallAfter(self.log_to_console,
                     f"Resumo iniciado: {video_id}", "INFO")
        wx.CallAfter(self.SetStatusText,
                     f"IA: Resumindo {video_id}...", 0)

    def _on_ai_summary_completed(self, video_id, summary_preview="", tags=None, **kwargs):
        tag_str = ", ".join(tags) if tags else "nenhuma"
        wx.CallAfter(self.log_to_console,
                     f"Resumo concluído: {video_id} (tags: {tag_str})", "SYSTEM")
        wx.CallAfter(self.SetStatusText,
                     f"IA: Resumo de {video_id} concluído", 0)

    def _on_ai_summary_error(self, video_id, error_msg="", **kwargs):
        wx.CallAfter(self.log_to_console,
                     f"Erro no resumo de {video_id}: {error_msg}", "ERROR")
        wx.CallAfter(self.SetStatusText,
                     f"IA: Erro ao resumir {video_id}", 0)
```


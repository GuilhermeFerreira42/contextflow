### Patch 1.2 — `SummaryStatusRenderer.Draw()` — Background-First Reforçado

**Localizar o método `Draw` da classe `SummaryStatusRenderer` e substituir integralmente:**

```python
# SUBSTITUIR O MÉTODO Draw COMPLETO DA CLASSE SummaryStatusRenderer:

def Draw(self, grid, attr, dc, rect, row, col, isSelected):
    theme = ThemeManager()

    # [BACKGROUND-FIRST — REGRA FASE 7.3]
    # PASSO 1 OBRIGATÓRIO: Preenche TODA a célula antes de qualquer texto.
    # Ocorre ANTES do SetClippingRegion para garantir cobertura total,
    # incluindo as bordas que o ClippingRegion poderia deixar de fora.
    bg_color = (
        theme.get_grid_selection_bg() if isSelected
        else theme.get_grid_bg()
    )
    dc.SetBrush(wx.Brush(bg_color))
    dc.SetPen(wx.TRANSPARENT_PEN)
    dc.DrawRectangle(rect)  # Limpa 100% da área — elimina artefatos nativos

    # PASSO 2: Clipping e dados — só após limpeza do fundo
    dc.SetClippingRegion(rect)
    table = grid.GetTable()
    if row >= len(table.data):
        dc.DestroyClippingRegion()
        return

    item = table.data[row]
    ss = item.get('summary_status', '')

    # PASSO 3: Determina ícone e cor do texto baseado no status
    if ss == 'summarizing':
        icon = "⏳"
        color = (
            theme.get_accent_color() if not isSelected
            else theme.get_grid_selection_fg()
        )
        bold = False
    elif ss == 'summary_error':
        icon = "❌"
        color = (
            wx.Colour(220, 53, 69) if not isSelected
            else theme.get_grid_selection_fg()
        )
        bold = False
    elif ss == 'summarized':
        icon = "✓"
        color = (
            wx.Colour(40, 167, 69) if not isSelected
            else theme.get_grid_selection_fg()
        )
        bold = False
    else:
        # [7.1 PENDÊNCIA 3] CTA explícito "✦ Resumir" em destaque
        icon = "✦ Resumir"
        color = (
            theme.get_accent_color() if not isSelected
            else theme.get_grid_selection_fg()
        )
        bold = True

    # PASSO 4: Texto desenhado SOBRE o fundo já limpo
    dc.SetTextForeground(color)
    weight = wx.FONTWEIGHT_BOLD if bold else wx.FONTWEIGHT_NORMAL
    dc.SetFont(wx.Font(9, wx.FONTFAMILY_DEFAULT, wx.FONTSTYLE_NORMAL, weight))

    tw, th = dc.GetTextExtent(icon)
    x = rect.x + (rect.width - tw) // 2
    y = rect.y + (rect.height - th) // 2
    dc.DrawText(icon, x, y)
    dc.DestroyClippingRegion()
```


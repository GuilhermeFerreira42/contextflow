#### T07 — Persistência de Largura de Colunas

**Arquivo:** `ui/tab_analysis.py`

Adicionar no `__init__`, após `self._init_ui()`:

```python
        self._col_save_timer = wx.Timer(self)
        self.Bind(wx.EVT_TIMER, self._on_col_save_tick, self._col_save_timer)
```

Adicionar no `_bind_events`:

```python
        # [FASE 6.2] Persistência de colunas
        self.grid.Bind(wx.grid.EVT_GRID_COL_SIZE, self._on_col_resized)
```

Adicionar após `_init_ui`, chamar restauração:

```python
        # [FASE 6.2] Restaurar larguras salvas
        wx.CallAfter(self._restore_column_widths)
```

Novos métodos:

```python
    # ══════════════════════════════════════════════════════
    # FASE 6.2 — PERSISTÊNCIA DE COLUNAS
    # ══════════════════════════════════════════════════════

    def _restore_column_widths(self):
        """
        Restaura larguras de colunas salvas no ConfigManager.
        [FALHA GRACEFUL] Se não houver dados salvos, mantém defaults.
        """
        try:
            all_widths = self.app_state.config.get("ui", "column_widths", {})
            saved = all_widths.get("tab_analysis", {})
            if not saved:
                return

            for idx, label in enumerate(self.col_labels):
                width = saved.get(label)
                if isinstance(width, int) and 20 <= width <= 2000:
                    self.grid.SetColSize(idx, width)

            self.grid.ForceRefresh()
        except Exception as e:
            import logging
            logging.getLogger("contextflow.ui.analysis").warning(
                f"Falha ao restaurar larguras de colunas: {e}")

    def _on_col_resized(self, event):
        """
        Captura redimensionamento de coluna com debounce.
        [PERFORMANCE] Não salva a cada pixel — agenda para 500ms.
        """
        # Reinicia timer de debounce
        if self._col_save_timer.IsRunning():
            self._col_save_timer.Stop()
        self._col_save_timer.Start(500, oneShot=True)
        event.Skip()

    def _on_col_save_tick(self, event):
        """Timer de debounce disparou — salvar larguras."""
        self._save_column_widths()

    def _save_column_widths(self):
        """Persiste larguras atuais no ConfigManager."""
        try:
            widths = {}
            for idx, label in enumerate(self.col_labels):
                widths[label] = self.grid.GetColSize(idx)

            all_widths = self.app_state.config.get("ui", "column_widths", {})
            all_widths["tab_analysis"] = widths
            self.app_state.config.set("ui", "column_widths", all_widths)
        except Exception as e:
            import logging
            logging.getLogger("contextflow.ui.analysis").warning(
                f"Falha ao salvar larguras de colunas: {e}")
```


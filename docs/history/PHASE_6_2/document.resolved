## 6. SCRIPT DE VERIFICAÇÃO

**Arquivo NOVO:** `scripts/verification/verify_phase_6_2.py`

```python
# scripts/verification/verify_phase_6_2.py
"""
Script de verificação da Fase 6.2 — Refinamento, UX e Organização.
Testa limpeza de arquivos, configurações, e infraestrutura de tema.
"""
import os
import sys
import json

# Add project root to sys.path
sys.path.append(os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..')))


def verify():
    results = []
    total = 0
    passed = 0

    def check(name, condition, detail=""):
        nonlocal total, passed
        total += 1
        status = "✅ PASS" if condition else "❌ FAIL"
        if condition:
            passed += 1
        results.append(f"  {status}: {name}")
        if detail and not condition:
            results.append(f"         → {detail}")

    print("=" * 60)
    print("VERIFICAÇÃO FASE 6.2 — ContextFlow")
    print("=" * 60)

    # ─── T01: Limpeza de Scripts ───────────────────────────
    print("\n📁 T01 — Limpeza de Scripts")
    check("scripts/debug/ removido",
          not os.path.exists("scripts/debug"),
          "Diretório scripts/debug/ ainda existe")
    check("scripts/verification/ existe",
          os.path.isdir("scripts/verification"),
          "Diretório scripts/verification/ não encontrado")
    check("verify_brake.py presente",
          os.path.isfile("scripts/verification/verify_brake.py"))
    check("verify_integrity.py presente",
          os.path.isfile("scripts/verification/verify_integrity.py"))

    # ─── T02: DialogConfig ─────────────────────────────────
    print("\n🔧 T02 — DialogConfig Saneado")
    try:
        with open("ui/dialog_config.py", "r", encoding="utf-8") as f:
            dc_content = f.read()
        check("OpenAI removido da UI",
              '"OpenAI API Key:"' not in dc_content
              or 'openai' not in dc_content.split("providers")[0] if "providers" in dc_content else True,
              "Referência a OpenAI ainda visível no dialog")
        check("Seletor de Inteligência Ativa removido",
              "Seletor de Inteligência Ativa" not in dc_content,
              "Bloco 'Seletor de Inteligência Ativa' ainda presente")
        check("Tamanho >= 960x720",
              "980" in dc_content or "960" in dc_content,
              "Tamanho do dialog parece não ter sido ajustado")
        check("SpinCtrl max=100",
              "max=100" in dc_content,
              "Limites de SpinCtrl não ajustados para 100")
    except FileNotFoundError:
        check("dialog_config.py encontrado", False, "Arquivo não existe")

    # ─── T03: ConfigManager Defaults ───────────────────────
    print("\n⚙️ T03 — ConfigManager Defaults")
    try:
        from core.config_manager import ConfigManager
        cfg = ConfigManager()
        defaults = cfg._get_default_config()

        check("Default active_provider = ollama",
              defaults["orchestration"]["active_provider"] == "ollama",
              f"Encontrado: {defaults['orchestration']['active_provider']}")
        check("Default ui.theme existe",
              "theme" in defaults.get("ui", {}),
              "Chave ui.theme não encontrada nos defaults")
        check("Default ui.column_widths existe",
              "column_widths" in defaults.get("ui", {}),
              "Chave ui.column_widths não encontrada")
    except Exception as e:
        check("ConfigManager importável", False, str(e))

    # ─── T04: TagWrapPanel ─────────────────────────────────
    print("\n🏷️ T04 — TagWrapPanel")
    check("ui/components/__init__.py existe",
          os.path.isfile("ui/components/__init__.py"))
    check("ui/components/tag_wrap_panel.py existe",
          os.path.isfile("ui/components/tag_wrap_panel.py"))
    try:
        from ui.components.tag_wrap_panel import TagWrapPanel
        check("TagWrapPanel importável", True)
    except Exception as e:
        check("TagWrapPanel importável", False, str(e))

    # ─── T05: Sidebar Resumir ──────────────────────────────
    print("\n📂 T05 — Sidebar Resumir")
    try:
        with open("ui/sidebar.py", "r", encoding="utf-8") as f:
            sb_content = f.read()
        check("on_summarize_video existe",
              "on_summarize_video" in sb_content)
        check("on_summarize_playlist existe",
              "on_summarize_playlist" in sb_content)
        check("Menu '✨ Resumir Vídeo' existe",
              "Resumir Vídeo" in sb_content)
        check("Menu '✨ Resumir Playlist' existe",
              "Resumir Playlist" in sb_content)
    except FileNotFoundError:
        check("sidebar.py encontrado", False)

    # ─── T06: SummaryStatusRenderer ────────────────────────
    print("\n📊 T06 — Coluna Resumo Visual")
    try:
        with open("ui/virtual_table.py", "r", encoding="utf-8") as f:
            vt_content = f.read()
        check("SummaryStatusRenderer definido",
              "class SummaryStatusRenderer" in vt_content)
        check("SummaryStatusRenderer usado no GetAttr",
              "SummaryStatusRenderer()" in vt_content)
    except FileNotFoundError:
        check("virtual_table.py encontrado", False)

    # ─── T07: Persistência de Colunas ──────────────────────
    print("\n📐 T07 — Persistência de Colunas")
    try:
        with open("ui/tab_analysis.py", "r", encoding="utf-8") as f:
            ta_content = f.read()
        check("_restore_column_widths presente",
              "_restore_column_widths" in ta_content)
        check("_save_column_widths presente",
              "_save_column_widths" in ta_content)
        check("EVT_GRID_COL_SIZE binding presente",
              "EVT_GRID_COL_SIZE" in ta_content)
    except FileNotFoundError:
        check("tab_analysis.py encontrado", False)

    try:
        with open("ui/tab_batch.py", "r", encoding="utf-8") as f:
            tb_content = f.read()
        check("_restore_column_widths em tab_batch",
              "_restore_column_widths" in tb_content)
    except FileNotFoundError:
        check("tab_batch.py encontrado", False)

    # ─── T08: ThemeManager Multi-Tema ──────────────────────
    print("\n🎨 T08 — ThemeManager")
    try:
        from core.managers.theme_manager import ThemeManager
        tm = ThemeManager()

        check("THEMES dict existe",
              hasattr(ThemeManager, 'THEMES'))
        check("Tema 'light' disponível",
              "light" in ThemeManager.THEMES)
        check("Tema 'dark' disponível",
              "dark" in ThemeManager.THEMES)
        check("Método color() existe",
              hasattr(tm, 'color'))
        check("Método css_color() existe",
              hasattr(tm, 'css_color'))
        check("Método set_theme() existe",
              hasattr(tm, 'set_theme'))
        check("Método is_dark() existe",
              hasattr(tm, 'is_dark'))
        check("Método get_success_color() existe",
              hasattr(tm, 'get_success_color'))
        check("Método get_muted_color() existe",
              hasattr(tm, 'get_muted_color'))

        # Testa que cores light e dark são diferentes
        light_bg = ThemeManager.THEMES["light"]["bg"]
        dark_bg = ThemeManager.THEMES["dark"]["bg"]
        check("Cores light != dark",
              light_bg != dark_bg,
              "Paletas light e dark são idênticas")

        # Testa tokens mínimos
        required_tokens = [
            "bg", "fg", "accent", "highlight", "border",
            "success", "warning", "error", "muted",
            "console_bg", "console_fg", "grid_line"
        ]
        for token in required_tokens:
            check(f"Token '{token}' em light",
                  token in ThemeManager.THEMES["light"])
            check(f"Token '{token}' em dark",
                  token in ThemeManager.THEMES["dark"])

    except Exception as e:
        check("ThemeManager importável", False, str(e))

    # ─── T09: Toggle de Tema ──────────────────────────────
    print("\n🌙 T09 — Toggle de Tema")
    try:
        with open("ui/app_window.py", "r", encoding="utf-8") as f:
            aw_content = f.read()
        check("on_toggle_theme handler existe",
              "on_toggle_theme" in aw_content)
        check("THEME_CHANGED publicado",
              "THEME_CHANGED" in aw_content)
        check("item_dark_mode no menu",
              "item_dark_mode" in aw_content)
    except FileNotFoundError:
        check("app_window.py encontrado", False)

    # ─── T10: Adaptação de Componentes ─────────────────────
    print("\n🔄 T10 — Adaptação de Componentes")
    files_to_check = [
        ("ui/tab_analysis.py", "_on_theme_changed"),
        ("ui/tab_batch.py", "_on_theme_changed"),
        ("ui/sidebar.py", "_on_theme_changed"),
        ("ui/panel_console.py", "_on_theme_changed"),
        ("ui/panel_detail.py", "_on_theme_changed"),
    ]
    for filepath, method in files_to_check:
        try:
            with open(filepath, "r", encoding="utf-8") as f:
                content = f.read()
            check(f"{filepath} tem {method}",
                  method in content)
        except FileNotFoundError:
            check(f"{filepath} encontrado", False)

    # Verifica que panel_detail usa css_color
    try:
        with open("ui/panel_detail.py", "r", encoding="utf-8") as f:
            pd_content = f.read()
        check("panel_detail usa css_color para HTML",
              "css_color" in pd_content,
              "HTML ainda usa cores hardcoded")
    except FileNotFoundError:
        pass

    # ─── RESULTADO FINAL ───────────────────────────────────
    print("\n" + "=" * 60)
    print(f"RESULTADO: {passed}/{total} verificações passaram")
    print("=" * 60)

    for r in results:
        print(r)

    if passed == total:
        print(f"\n🎉 FASE 6.2 VERIFICADA COM SUCESSO!")
    else:
        print(f"\n⚠️ {total - passed} verificação(ões) falharam.")

    return passed == total


if __name__ == '__main__':
    verify()
```


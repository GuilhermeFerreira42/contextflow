#### T06 — Coluna "Resumo" como Indicador Visual

**Arquivo:** `ui/virtual_table.py`

**Novo renderer** (adicionar antes da classe `VirtualVideoTable`):

```python
class SummaryStatusRenderer(wx.grid.GridCellRenderer):
    """
    [FASE 6.2] Indicador visual compacto de status de resumo.
    Substitui texto longo ilegível por ícone + label curto.

    Estados:
    - Pendente  → ○ cinza + "—"
    - Resumindo → ◔ azul + "IA"
    - Concluído → ● verde + "OK"
    - Erro      → ● vermelho + "!"
    """

    def Draw(self, grid, attr, dc, rect, row, col, isSelected):
        # Limpa fundo
        bg_color = (grid.GetDefaultCellBackgroundColour()
                    if not isSelected else grid.GetSelectionBackground())
        dc.SetBrush(wx.Brush(bg_color))
        dc.SetPen(wx.TRANSPARENT_PEN)
        dc.DrawRectangle(rect)

        dc.SetClippingRegion(rect)

        table = grid.GetTable()
        if row >= len(table.data):
            dc.DestroyClippingRegion()
            return

        theme = ThemeManager()
        item = table.data[row]
        ss = item.get("summary_status", "") or ""

        # Determina ícone e cor
        if ss == "summarized":
            circle_color = theme.get_success_color()
            label = "OK"
        elif ss == "summarizing":
            circle_color = theme.get_accent_color()
            label = "IA"
        elif ss == "summary_error":
            circle_color = theme.get_error_color()
            label = "!"
        else:
            circle_color = theme.get_muted_color()
            label = "—"

        # Desenha círculo
        circle_x = rect.x + 16
        circle_y = rect.y + rect.height // 2
        dc.SetBrush(wx.Brush(circle_color))
        dc.SetPen(wx.Pen(wx.WHITE, 1))
        dc.DrawCircle(circle_x, circle_y, 5)

        # Desenha texto
        txt_color = (theme.get_fg_color()
                     if not isSelected else wx.WHITE)
        dc.SetTextForeground(txt_color)
        dc.SetFont(wx.Font(8, wx.FONTFAMILY_DEFAULT,
                           wx.FONTSTYLE_NORMAL, wx.FONTWEIGHT_BOLD))
        dc.DrawText(label, circle_x + 10,
                    rect.y + (rect.height // 2 - 7))

        dc.DestroyClippingRegion()

    def GetBestSize(self, grid, attr, dc, row, col):
        return wx.Size(70, 45)

    def Clone(self):
        return SummaryStatusRenderer()
```


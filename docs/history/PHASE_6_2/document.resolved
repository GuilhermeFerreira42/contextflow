    def _on_theme_changed(self, theme, **kwargs):
        """[FASE 6.2] Reaplica cores e recarrega HTML."""
        def _apply():
            self.theme = ThemeManager()
            self.SetBackgroundColour(self.theme.get_bg_color())
            self.SetForegroundColour(self.theme.get_fg_color())

            # Recarrega HTML com CSS atualizado se tiver conteúdo
            if self._current_transcript and self.browser:
                self._render_html(self._current_transcript)

            self.Refresh()
        wx.CallAfter(_apply)
```

Extrair renderização HTML para método dedicado (substituir inline no `load_video`):

```python
    def _render_html(self, transcript_text: str):
        """Renderiza HTML com CSS do tema ativo."""
        if not self.browser:
            return

        html_content = f"""
        <html>
        <head>
        <style>
            body {{
                font-family: 'Segoe UI', sans-serif;
                line-height: 1.6;
                padding: 20px;
                background-color: {self.theme.css_color('bg')};
                color: {self.theme.css_color('fg')};
                margin: 0;
            }}
            h3 {{
                color: {self.theme.css_color('accent')};
                border-bottom: 1px solid {self.theme.css_color('border')};
                padding-bottom: 10px;
            }}
            p {{ white-space: pre-wrap; }}
        </style>
        </head>
        <body>
            <h3>Transcrição</h3>
            <p>{transcript_text}</p>
        </body>
        </html>
        """
        self.browser.SetPage(html_content, "")
```

No `load_video`, substituir a seção de HTML:

```python
    def load_video(self, video_data: dict, transcript_text: str):
        # ... (código existente de meta e thumbnail) ...

        # Salvar referências para re-render em mudança de tema
        self._current_transcript = transcript_text
        self._current_video_data = video_data
        self.current_video_id = video_data.get('id')

        # Renderizar conteúdo
        if self.browser:
            self._render_html(transcript_text)
        else:
            self.txt_content.SetValue(transcript_text)

        # Update Stats
        t_count = video_data.get('token_count', 0)
        self.lbl_stats.SetLabel(f"Tokens: {t_count} (Estimado)")
```


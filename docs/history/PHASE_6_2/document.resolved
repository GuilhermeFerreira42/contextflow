#### T08 — ThemeManager Multi-Tema

**Arquivo:** `core/managers/theme_manager.py`

Substituição completa:

```python
# contextflow/core/managers/theme_manager.py
"""
[FASE 6.2] Gerenciador de temas com suporte a Light e Dark Mode.
Singleton com paleta centralizada e API de consulta por token semântico.
"""
import wx
import logging
from core.config_manager import ConfigManager

logger = logging.getLogger("contextflow.theme")


class ThemeManager:
    """
    Singleton que gerencia paletas de cores para Light e Dark Mode.
    Todas as cores da aplicação devem ser obtidas via este gerenciador.
    """
    _instance = None

    # ═══════════════════════════════════════════════════════
    # PALETAS DE CORES
    # ═══════════════════════════════════════════════════════
    THEMES = {
        "light": {
            "bg":             wx.Colour(255, 255, 255),
            "fg":             wx.Colour(30, 30, 30),
            "accent":         wx.Colour(0, 120, 215),
            "highlight":      wx.Colour(240, 240, 240),
            "border":         wx.Colour(220, 220, 220),
            "panel":          wx.Colour(248, 249, 250),
            "muted":          wx.Colour(130, 130, 130),
            "success":        wx.Colour(40, 167, 69),
            "warning":        wx.Colour(221, 107, 32),
            "error":          wx.Colour(220, 53, 69),
            "console_bg":     wx.Colour(255, 255, 255),
            "console_fg":     wx.Colour(30, 30, 30),
            "selection_bg":   wx.Colour(0, 120, 215),
            "selection_fg":   wx.Colour(255, 255, 255),
            "grid_line":      wx.Colour(220, 220, 220),
            "placeholder_bg": wx.Colour(200, 200, 200),
            "header_bg":      wx.Colour(248, 249, 250),
            "button_danger":  wx.Colour(239, 68, 68),
            "button_primary": wx.Colour(37, 99, 235),
            "link":           wx.Colour(0, 120, 215),
            "subtitle":       wx.Colour(100, 116, 139),
        },
        "dark": {
            "bg":             wx.Colour(30, 30, 30),
            "fg":             wx.Colour(220, 220, 220),
            "accent":         wx.Colour(78, 148, 255),
            "highlight":      wx.Colour(50, 50, 50),
            "border":         wx.Colour(70, 70, 70),
            "panel":          wx.Colour(37, 37, 38),
            "muted":          wx.Colour(140, 140, 140),
            "success":        wx.Colour(72, 187, 120),
            "warning":        wx.Colour(245, 158, 11),
            "error":          wx.Colour(248, 113, 113),
            "console_bg":     wx.Colour(24, 24, 24),
            "console_fg":     wx.Colour(200, 200, 200),
            "selection_bg":   wx.Colour(51, 103, 214),
            "selection_fg":   wx.Colour(255, 255, 255),
            "grid_line":      wx.Colour(60, 60, 60),
            "placeholder_bg": wx.Colour(50, 50, 50),
            "header_bg":      wx.Colour(40, 40, 42),
            "button_danger":  wx.Colour(220, 38, 38),
            "button_primary": wx.Colour(59, 130, 246),
            "link":           wx.Colour(96, 165, 250),
            "subtitle":       wx.Colour(148, 163, 184),
        }
    }

    def __new__(cls):
        if cls._instance is None:
            cls._instance = super(ThemeManager, cls).__new__(cls)
            cls._instance._initialized = False
        return cls._instance

    def __init__(self):
        if self._initialized:
            return
        self._initialized = True

        config = ConfigManager()
        self._theme_name = config.get("ui", "theme", "light")
        if self._theme_name not in self.THEMES:
            self._theme_name = "light"

        self._palette = self.THEMES[self._theme_name]
        logger.info(f"ThemeManager: Tema '{self._theme_name}' inicializado.")

    # ═══════════════════════════════════════════════════════
    # API PÚBLICA — Consulta de cores por token
    # ═══════════════════════════════════════════════════════

    def color(self, token: str) -> wx.Colour:
        """
        Retorna a cor associada ao token semântico.
        Fallback para branco se o token não existir.
        """
        return self._palette.get(token, wx.Colour(255, 255, 255))

    def get_theme_name(self) -> str:
        return self._theme_name

    def is_dark(self) -> bool:
        return self._theme_name == "dark"

    # Aliases retrocompatíveis (mantidos para não quebrar código existente)
    def get_bg_color(self) -> wx.Colour:
        return self.color("bg")

    def get_fg_color(self) -> wx.Colour:
        return self.color("fg")

    def get_accent_color(self) -> wx.Colour:
        return self.color("accent")

    def get_border_color(self) -> wx.Colour:
        return self.color("border")

    def get_highlight_color(self) -> wx.Colour:
        return self.color("highlight")

    # Novos accessors semânticos (Fase 6.2)
    def get_success_color(self) -> wx.Colour:
        return self.color("success")

    def get_warning_color(self) -> wx.Colour:
        return self.color("warning")

    def get_error_color(self) -> wx.Colour:
        return self.color("error")

    def get_muted_color(self) -> wx.Colour:
        return self.color("muted")

    def get_console_bg(self) -> wx.Colour:
        return self.color("console_bg")

    def get_console_fg(self) -> wx.Colour:
        return self.color("console_fg")

    def get_panel_color(self) -> wx.Colour:
        return self.color("panel")

    def get_grid_line_color(self) -> wx.Colour:
        return self.color("grid_line")

    # ═══════════════════════════════════════════════════════
    # TROCA DE TEMA
    # ═══════════════════════════════════════════════════════

    def set_theme(self, theme_name: str):
        """
        Troca o tema ativo e persiste no ConfigManager.
        NÃO aplica às janelas — o PubSub 'THEME_CHANGED' cuida disso.
        """
        if theme_name not in self.THEMES:
            logger.warning(f"Tema '{theme_name}' não existe. Ignorando.")
            return

        self._theme_name = theme_name
        self._palette = self.THEMES[theme_name]

        config = ConfigManager()
        config.set("ui", "theme", theme_name)

        logger.info(f"ThemeManager: Tema alterado para '{theme_name}'.")

    # ═══════════════════════════════════════════════════════
    # APLICAÇÃO RECURSIVA
    # ═══════════════════════════════════════════════════════

    def apply_theme(self, window: wx.Window):
        """
        Aplica cores base recursivamente a um widget e seus filhos.
        [NOTA] Componentes customizados (Grid, WebView) precisam
        de tratamento individual via seus handlers de THEME_CHANGED.
        """
        try:
            window.SetBackgroundColour(self.color("bg"))
            window.SetForegroundColour(self.color("fg"))
        except Exception:
            pass

        for child in window.GetChildren():
            try:
                self.apply_theme(child)
            except Exception:
                pass

        try:
            window.Refresh()
        except Exception:
            pass

    # ═══════════════════════════════════════════════════════
    # HELPERS PARA HTML/CSS
    # ═══════════════════════════════════════════════════════

    def css_color(self, token: str) -> str:
        """Retorna cor como string CSS hex (ex: '#1e1e1e')."""
        c = self.color(token)
        return f"#{c.Red():02x}{c.Green():02x}{c.Blue():02x}"
```


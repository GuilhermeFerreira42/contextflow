Métodos (idênticos em estrutura, muda apenas a key):

```python
    # ══════════════════════════════════════════════════════
    # FASE 6.2 — PERSISTÊNCIA DE COLUNAS
    # ══════════════════════════════════════════════════════

    def _restore_column_widths(self):
        """Restaura larguras salvas do ConfigManager."""
        try:
            all_widths = self.app_state.config.get("ui", "column_widths", {})
            saved = all_widths.get("tab_batch", {})
            if not saved:
                return

            for idx, label in enumerate(self.table.col_labels):
                width = saved.get(label)
                if isinstance(width, int) and 20 <= width <= 2000:
                    self.grid.SetColSize(idx, width)

            self.grid.ForceRefresh()
        except Exception:
            pass

    def _on_col_resized(self, event):
        """Debounce de 500ms antes de salvar."""
        if self._col_save_timer.IsRunning():
            self._col_save_timer.Stop()
        self._col_save_timer.Start(500, oneShot=True)
        event.Skip()

    def _on_col_save_tick(self, event):
        self._save_column_widths()

    def _save_column_widths(self):
        """Persiste larguras atuais."""
        try:
            widths = {}
            for idx, label in enumerate(self.table.col_labels):
                widths[label] = self.grid.GetColSize(idx)

            all_widths = self.app_state.config.get("ui", "column_widths", {})
            all_widths["tab_batch"] = widths
            self.app_state.config.set("ui", "column_widths", all_widths)
        except Exception:
            pass
```

